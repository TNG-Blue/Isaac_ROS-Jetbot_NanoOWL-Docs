# Doxyfile configuration for Isaac ROS Jetbot NanoOWL
# This file is used to generate API documentation from source code
# Generated: January 26, 2025
# Template: CMake-based Doxygen configuration

#---------------------------------------------------------------------------
# Project Information
#---------------------------------------------------------------------------

PROJECT_NAME           = "Isaac ROS Jetbot NanoOWL"
PROJECT_NUMBER         = "1.0.0"
PROJECT_BRIEF          = "Enterprise-grade autonomous robotics platform powered by NVIDIA Jetson Orin Nano Super"
PROJECT_LOGO           = "@CMAKE_CURRENT_SOURCE_DIR@/docs/images/isaac_ros-jetbot_nanoowl.svg"

#---------------------------------------------------------------------------
# Build Settings
#---------------------------------------------------------------------------

OUTPUT_DIRECTORY       = "@CMAKE_CURRENT_BINARY_DIR@/doxygen"
CREATE_SUBDIRS         = NO
CREATE_SUBDIRS_LEVEL   = 2
OUTPUT_LANGUAGE        = English
BRIEF_MEMBER_DESC      = YES
REPEAT_BRIEF           = YES
ABBREVIATE_BRIEF       = "The $name class" \
                         "The $name widget" \
                         "The $name file" \
                         is \
                         provides \
                         specifies \
                         contains \
                         represents \
                         a \
                         an \
                         the

ALWAYS_DETAILED_SEC    = NO
INLINE_INHERITED_MEMB  = YES
FULL_PATH_NAMES        = NO
STRIP_FROM_PATH        = "@CMAKE_CURRENT_SOURCE_DIR@"
STRIP_FROM_INC_PATH    = "@CMAKE_CURRENT_SOURCE_DIR@/include"

SHORT_NAMES            = NO
JAVADOC_AUTOBRIEF      = YES
JAVADOC_BANNER         = NO
QT_AUTOBRIEF           = NO
MULTILINE_CPP_IS_BRIEF = NO
INHERIT_DOCS           = YES
SEPARATE_MEMBER_PAGES  = YES

TAB_SIZE               = 4
ALIASES                = "constexpr=\xrefitem constexpr \"Constexpr Specification\" \"Constexpr Specifications\""

TCL_SUBST              =

#---------------------------------------------------------------------------
# Warning and Progress Messages
#---------------------------------------------------------------------------

QUIET                  = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_LACKED     = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = NO
WARN_IF_UNUSED_PARAM   = NO
WARN_IF_UNUSED_TEMPLATE= NO
WARN_AS_ERROR          = NO
WARN_FORMAT            = "$file:$line: $text"
WARN_LOGFILE           = "@CMAKE_CURRENT_BINARY_DIR@/doxygen_warnings.log"

#---------------------------------------------------------------------------
# Input Files
#---------------------------------------------------------------------------

INPUT                  = "@CMAKE_CURRENT_SOURCE_DIR@/docs" \
                         "@CMAKE_CURRENT_SOURCE_DIR@/../CUDA/include" \
                         "@CMAKE_CURRENT_SOURCE_DIR@/../ROS/src"

INPUT_ENCODING         = UTF-8

FILE_PATTERNS          = *.c \
                         *.cc \
                         *.cxx \
                         *.cpp \
                         *.c++ \
                         *.h \
                         *.hh \
                         *.hpp \
                         *.h++ \
                         *.md \
                         *.py

RECURSIVE              = YES

EXCLUDE                = "@CMAKE_CURRENT_SOURCE_DIR@/../build" \
                         "@CMAKE_CURRENT_SOURCE_DIR@/../install" \
                         "@CMAKE_CURRENT_SOURCE_DIR@/../.git" \
                         "*/test/*" \
                         "*/tests/*"

EXCLUDE_SYMLINKS       = NO

EXCLUDE_PATTERNS       = "*/.git/*" \
                         "*/build/*" \
                         "*/install/*" \
                         "*/.colcon/*" \
                         "*/\..*"

EXCLUDE_SYMBOLS        = __* \
                         _*

EXAMPLE_PATH           = "@CMAKE_CURRENT_SOURCE_DIR@/../Examples"

EXAMPLE_PATTERNS       = *.cpp \
                         *.py \
                         *.cpp \
                         *.cxx

EXAMPLE_RECURSIVE      = YES

IMAGE_PATH             = "@CMAKE_CURRENT_SOURCE_DIR@/docs/images"

INPUT_FILTER           =

FILTER_SOURCE_FILES    = NO

FILTER_SOURCE_PATTERNS =

USE_MDFILE_AS_MAINPAGE = "@CMAKE_CURRENT_SOURCE_DIR@/docs/index.md"

#---------------------------------------------------------------------------
# Source Browsing
#---------------------------------------------------------------------------

SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
REFERENCES_LINK_SOURCE = YES
SOURCE_TOOLTIPS        = YES
USE_HTAGS              = NO
VERBATIM_HEADERS       = YES

CLANG_ASSISTED_PARSING = NO
CLANG_OPTIONS          =

#---------------------------------------------------------------------------
# Index
#---------------------------------------------------------------------------

ALPHABETICAL_INDEX     = YES
COLS_IN_ALPHA_INDEX    = 5
IGNORE_PREFIX          = jetbot_

#---------------------------------------------------------------------------
# HTML Output
#---------------------------------------------------------------------------

GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html

HTML_HEADER            = "@CMAKE_CURRENT_SOURCE_DIR@/overrides/header.html"
HTML_FOOTER            = "@CMAKE_CURRENT_SOURCE_DIR@/overrides/footer.html"
HTML_STYLESHEET        = "@CMAKE_CURRENT_SOURCE_DIR@/stylesheets/doxygen.css"
HTML_EXTRA_STYLESHEET  = "@CMAKE_CURRENT_SOURCE_DIR@/stylesheets/extra.css"

HTML_EXTRA_FILES       = "@CMAKE_CURRENT_SOURCE_DIR@/javascripts/extra.js"

HTML_COLORSTYLE_HUE    = 76
HTML_COLORSTYLE_SAT    = 184
HTML_COLORSTYLE_GAMMA  = 100

HTML_TIMESTAMP         = YES
HTML_DYNAMIC_SECTIONS  = YES
HTML_INDEX_NUM_ENTRIES = 100

GENERATE_DOCSET        = NO
DOCSET_FEEDNAME        = "Isaac ROS Jetbot NanoOWL API"
DOCSET_BUNDLE_ID       = com.tngblue.isaacros.jetbot

GENERATE_HTMLHELP      = NO

GENERATE_CHI           = NO

GENERATE_QHP           = NO

GENERATE_ECLIPSEHELP   = NO

DISABLE_INDEX          = NO
GENERATE_TREEVIEW      = YES
TREEVIEW_WIDTH         = 250
EXT_LINKS_IN_WINDOW    = NO

OBFUSCATE_EMAILS       = YES
HTML_FORMULA_FORMAT    = png
USE_MATHJAX            = YES
MATHJAX_VERSION        = MathJax_3
MATHJAX_RELPATH        = https://cdn.jsdelivr.net/npm/mathjax@3/es5/
MATHJAX_EXTENSIONS    = TeX/AMSmath \
                        TeX/AMSsymbols

SEARCHENGINE           = YES
SERVER_BASED_SEARCH    = NO
EXTERNAL_SEARCH        = NO

SEARCHDATA_FILE        = searchdata.xml

PRELOAD_LOCAL_DOXYGEN_DB = NO

#---------------------------------------------------------------------------
# LaTeX Output
#---------------------------------------------------------------------------

GENERATE_LATEX         = YES
LATEX_OUTPUT           = latex
LATEX_CMD_NAME         = latex
MAKEINDEX_CMD_NAME     = makeindex
LATEX_MAKEINDEX_CMD    = makeindex
COMPACT_LATEX          = NO
PAPER_TYPE             = a4
EXTRA_PACKAGES         = amsmath \
                         amssymb \
                         listings
LATEX_HEADER           = "@CMAKE_CURRENT_SOURCE_DIR@/overrides/latex_header.tex"
LATEX_FOOTER           = "@CMAKE_CURRENT_SOURCE_DIR@/overrides/latex_footer.tex"

PDF_HYPERLINKS         = YES
USE_PDFLATEX           = YES
PDFLATEX_CMD_NAME      = pdflatex
LATEX_BATCHMODE        = NO
LATEX_HIDE_INDICES     = NO
LATEX_SOURCE_CODE      = NO
LATEX_BIB_STYLE        = plain

#---------------------------------------------------------------------------
# RTF Output
#---------------------------------------------------------------------------

GENERATE_RTF           = NO
RTF_OUTPUT             = rtf
COMPACT_RTF            = NO
RTF_HYPERLINKS         = NO

#---------------------------------------------------------------------------
# Man Page Output
#---------------------------------------------------------------------------

GENERATE_MAN           = NO
MAN_OUTPUT             = man
MAN_EXTENSION          = .3

#---------------------------------------------------------------------------
# XML Output
#---------------------------------------------------------------------------

GENERATE_XML           = YES
XML_OUTPUT             = xml
XML_PROGRAMLISTING     = YES

#---------------------------------------------------------------------------
# DOCBOOK Output
#---------------------------------------------------------------------------

GENERATE_DOCBOOK       = NO
DOCBOOK_OUTPUT         = docbook

#---------------------------------------------------------------------------
# Preprocessor
#---------------------------------------------------------------------------

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO
SEARCH_INCLUDES        = YES

INCLUDE_PATH           = "@CMAKE_CURRENT_SOURCE_DIR@/../CUDA/include" \
                         "@CMAKE_CURRENT_SOURCE_DIR@/../ROS/src"

INCLUDE_FILE_PATTERNS  = *.h \
                         *.hpp

PREDEFINED             = DOXYGEN_SKIP \
                         CUDA_ENABLED=1 \
                         ROS2_ENABLED=1

SKIP_FUNCTION_MACROS   = YES

#---------------------------------------------------------------------------
# External References
#---------------------------------------------------------------------------

TAGFILES               =
GENERATE_TAGFILE       = "@CMAKE_CURRENT_BINARY_DIR@/doxygen.tag"
ALLEXTERNALS           = NO
EXTERNAL_GROUPS        = YES
EXTERNAL_PAGES         = YES

#---------------------------------------------------------------------------
# Graph Visualization
#---------------------------------------------------------------------------

CLASS_DIAGRAMS         = YES
DIA_PATH               =

HIDE_UNDOC_RELATIONS   = YES
HAVE_DOT               = YES
DOT_NUM_THREADS        = 0
DOT_FONTNAME           = "Fira Code"
DOT_FONTSIZE           = 10

CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
GROUP_GRAPHS           = YES
UML_LOOK               = NO
UML_LIMIT_NUM_FIELDS   = 10

TEMPLATE_RELATIONS     = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
CALL_GRAPH             = NO
CALLER_GRAPH           = NO

GRAPHICAL_HIERARCHY    = YES
DIRECTORY_GRAPH        = YES

DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = NO
DOT_PATH               =
DOTFILE_DIRS           =

DOT_GRAPH_MAX_NODES    = 50
MAX_DOT_GRAPH_DEPTH    = 0
DOT_TRANSPARENT        = NO
DOT_MULTIPLE_TARGETS   = NO

GENERATE_LEGEND        = YES
DOT_CLEANUP            = YES

#---------------------------------------------------------------------------
# Build Related Configuration Options
#---------------------------------------------------------------------------

EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_PACKAGE        = NO
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_LOCAL_METHODS  = NO
EXTRACT_ANON_NSPACES   = NO

HIDE_UNDOC_CLASSES     = NO
HIDE_UNDOC_MEMBERS     = YES
HIDE_UNDOC_RELATIONS   = YES
HIDE_FRIEND_COMPOUNDS  = NO
HIDE_IN_BODY_DOCS      = NO

INTERNAL_DOCS          = NO
CASE_SENSE_FILENAMES   = NO
HIDE_SCOPE_NAMES       = YES
HIDE_COMPOUND_REFERENCE= NO
SHOW_INCLUDE_FILES     = YES
SHOW_GROUPED_MEMB_INC  = NO
FORCE_LOCAL_RANGES     = NO

INLINE_INFO            = YES
SORT_MEMBER_DOCS       = YES
SORT_BRIEF_DOCS        = NO
SORT_MEMBERS_CTORS_1ST = NO
SORT_GROUP_NAMES       = NO
SORT_BY_SCOPE_NAME     = NO

STRICT_PROTO_MATCHING  = NO

GENERATE_TODOLIST      = YES
GENERATE_TESTLIST      = YES
GENERATE_BUGLIST       = YES
GENERATE_DEPRECATEDLIST= YES

ENABLED_SECTIONS       =

MAX_INITIALIZERS       = 30
MAX_FUNC_PROTO_LENGTH  = 60

SHOW_USED_FILES        = YES
SHOW_FILES             = YES
SHOW_NAMESPACES        = YES

FILE_VERSION_FILTER    =
LAYOUT_FILE            = "@CMAKE_CURRENT_SOURCE_DIR@/DoxygenLayout.xml"

CITE_BIB_FILES         =

#---------------------------------------------------------------------------
# Miscellaneous
#---------------------------------------------------------------------------

PERL_PATH              = /usr/bin/perl
MAN_EXTENSION          = .3

#---------------------------------------------------------------------------
# Custom settings for Isaac ROS Jetbot NanoOWL
#---------------------------------------------------------------------------

# Enable markdown support
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES

# Color scheme (NVIDIA-inspired)
HTML_COLORSTYLE_HUE    = 76
HTML_COLORSTYLE_SAT    = 184
HTML_COLORSTYLE_GAMMA  = 100

# Namespace prefix for API documentation
IGNORE_PREFIX          = jetbot_

# Project-specific settings
GENERATE_TODOLIST      = YES
GENERATE_TESTLIST      = YES
GENERATE_BUGLIST       = YES

#---------------------------------------------------------------------------
# End of Doxyfile Configuration
